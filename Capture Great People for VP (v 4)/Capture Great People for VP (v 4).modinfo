<?xml version="1.0" encoding="utf-8"?>
<Mod id="0f96f649-aaf6-45f3-9b5c-65010eac2669" version="4">
  <Properties>
    <Name>Capture Great People for VP</Name>
    <Teaser>Great People are either captured (GA/GW/GMu/GE/GS/GMe/GD/GP, diplomatic units), provide a boost to the player (Space Ship Parts) or a bonus to the unit (GG/GA)</Teaser>
    <Description>Great People are either captured (GA/GW/GMu/GE/GS/GMe/GD/GP, diplomatic units), provide a [ICON_RESEARCH] boost to the player (Space Ship Parts) or a bonus to the unit (GG/GA). [NEWLINE][NEWLINE]Go to [COLOR_CYAN]http://www.picknmixmods.com/mods/CivV/Global/Capture%20Great%20People.html [/COLOR]to get the original version of this mod.</Description>
    <Authors>William Howard (enhancement update for VP by UndeadDevel), Jarcast</Authors>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
