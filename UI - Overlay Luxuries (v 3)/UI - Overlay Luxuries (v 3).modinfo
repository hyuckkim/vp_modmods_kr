<?xml version="1.0" encoding="utf-8"?>
<Mod id="ef3f23d4-a288-4c50-9937-0934dd2ed07e" version="3">
  <Properties>
    <Name>UI - Overlay Luxuries</Name>
    <Teaser>Highlight individual luxuries in strategic view</Teaser>
    <Description>Adds a "Luxuries" option to the overlay drop-down menu in the strategic view and adds check-boxes for each luxury; only selected luxuries are highlighted.</Description>
    <Authors>William Howard</Authors>
    <HideSetupGame>0</HideSetupGame>
    <Homepage>http://forums.2kgames.com/showthread.php?117570-MOD-UI-Resources</Homepage>
    <AffectsSavedGames>0</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
    <PediaCategory>UI</PediaCategory>
    <PediaAtlas>UNIT_ATLAS_2</PediaAtlas>
    <PediaIndex>47</PediaIndex>
  </Properties>
