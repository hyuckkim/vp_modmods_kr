<?xml version="1.0" encoding="utf-8"?>
<Mod id="1299a368-f6c8-4d02-af55-2fc863dd2fb4" version="7">
  <Properties>
    <Name>UI - No Auto-Embark Workers</Name>
    <Teaser>Stops automated workers from embarking.</Teaser>
    <Description>Stops automated workers from embarking; any automated worker that embarks is cancelled and placed back on dry land.

Also restricts the suggestion range for workable tiles.

Also enables "quick routes", workers for the human player on a "route to" will construct a road to the destination if there isn't one, otherwise will upgrade the road to a railway.</Description>
    <Authors>William Howard</Authors>
    <SpecialThanks>Mordino for the German translation</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <Homepage>http://forums.2kgames.com/showthread.php?117942-MOD-UI-No-Auto-Embark-Workers</Homepage>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
