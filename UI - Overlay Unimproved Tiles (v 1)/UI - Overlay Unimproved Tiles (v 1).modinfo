<?xml version="1.0" encoding="utf-8"?>
<Mod id="2fec6753-7ac8-443b-8844-1cb2d55f93de" version="1">
  <Properties>
    <Name>UI - Overlay Unimproved Tiles</Name>
    <Teaser>Highlight unimproved tiles in strategic view</Teaser>
    <Description>Adds an "Unimproved Tiles" option to the overlay drop-down menu in the strategic view and adds check-boxes for luxuries, strategics, workable bonuses, workable tiles and unupgraded roads; only selected items are highlighted.</Description>
    <Authors>William Howard</Authors>
    <SpecialThanks>biship for the suggestion</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>0</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
