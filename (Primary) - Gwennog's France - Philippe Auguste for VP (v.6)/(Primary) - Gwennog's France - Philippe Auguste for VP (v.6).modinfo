<Mod id="77cd9015-a4a5-490c-9d95-6499ed2d8554" version="6">
  <Properties>
    <Name>(Primary) - Gwennog's France - Philippe Auguste for VP</Name>
    <Stability>Alpha</Stability>
    <Teaser>[ICON_BULLET]Adds [COLOR_CYAN]France[ENDCOLOR], led by Philippe II Auguste, as a playable Civilization.
			[NEWLINE][ICON_BULLET]Requires at least the [COLOR_POSITIVE_TEXT]4.2[ENDCOLOR] version of Vox Populi for full compatibility.</Teaser>
    <Description>Adds France into the game, under the August King Philippe II</Description>
    <Authors>Gwennog with help of Hinin</Authors>
    <SpecialThanks>look at the forum page</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>1</ReloadAudioSystem>
    <ReloadLandmarkSystem>1</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>1</ReloadStrategicViewSystem>
    <ReloadUnitSystem>1</ReloadUnitSystem>
  </Properties>
