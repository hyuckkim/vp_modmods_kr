<?xml version="1.0" encoding="utf-8"?>
<Mod id="ba57b38a-e66d-4bcc-91f4-94a1d73f2a64" version="3">
  <Properties>
    <Name>Continental Drift</Name>
    <Teaser>A map type that creates varied worlds based on plate tectonics.</Teaser>
    <Description>Generates maps based on plate tectonics. Maps are similar to a combination of Fractal, Small Continents and Archipelago, with added tectonic elements like mountain belts and rift zones.
	Based on the map 'Tectonic'.</Description>
    <Authors>Haftetavenscrap, N.Core, axatin</Authors>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>0</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
