<Mod id="dcdaabd2-b224-4680-bdc0-d8692a1a1249" version="20"> 
  <Properties>
    <Name>Colonialist Legacies' Inuit for VP</Name>
    <Stability>Beta</Stability>
    <Teaser>Adds the [COLOR_POSITIVE_TEXT]Inuit[ENDCOLOR] to the game.</Teaser> 
    <Description>
		[NEWLINE][NEWLINE]----
		[NEWLINE][NEWLINE]Note:
		[NEWLINE]- Requires the Brave New World expansion.
		[NEWLINE]- Updates to the Mod will most likely break save games. Please do not update until you are ready to begin a new game.
		[NEWLINE][NEWLINE]----
		[NEWLINE][NEWLINE]Leader: Ekeuhnick
		[NEWLINE][NEWLINE]UA: Qauijimajatuqangit
		[NEWLINE]UU: Unatattik
		[NEWLINE]UI: Inuksuk
	</Description>
    <Authors>TPangolin, Neirai, Leugi, and pineappledan</Authors>
    <SpecialThanks>LastSword, JFD, regalmanemperor, Hiram, Viregel, Reedstilt, CharlatanAlley, Sukritact, Barathor, HungryForFood, Trystero49, Windiz</SpecialThanks>
