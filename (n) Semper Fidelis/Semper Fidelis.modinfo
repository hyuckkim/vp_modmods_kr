<?xml version="1.0" encoding="utf-8"?>
<Mod id="9db218ee-7efa-4b4c-c234-014666n8l33t" version="1">
  <Properties>
    <Name>(n) Semper Fidelis</Name>
    <Teaser>Adds 3 new Ideologies for Vox Populi, focussed on the Religious Victory</Teaser>
    <Description>Includes: 
	[NEWLINE][ICON_BULLET]Devotion -- a religious-fundementalism themed ideology
	[NEWLINE][ICON_BULLET]Harmony -- an environmentalism and international-cooperation themed ideology		
	[NEWLINE][ICON_BULLET]Prosperity -- a neoliberalism themed ideology
	[NEWLINE][ICON_BULLET]Ideology Balance -- changes to the base ideologies to (a) be compatible and (b) be balanced with the additions
[NEWLINE][NEWLINE]Does not include:
	[NEWLINE][ICON_BULLET]Religious Victory -- this is a separate mod
    </Description>
    <Authors>Hokath</Authors>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
