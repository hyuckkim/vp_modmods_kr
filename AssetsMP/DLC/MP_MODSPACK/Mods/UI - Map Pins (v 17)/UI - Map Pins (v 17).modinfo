<?xml version="1.0" encoding="utf-8"?>
<Mod id="96b31a10-8777-442f-9e6b-0f8fa969b86f" version="17">
  <Properties>
    <Name>UI - Map Pins</Name>
    <Teaser>Permits pins to be added to the map</Teaser>
    <Description>Enables pins, of different colours and with notes, to be added to the map

* Use Control-X to enter "pinboard mode"
* Use Control-X or Escape to exit "pinboard mode"
* When in "pinboard mode" click on the map to place a pin
* Right-Click on a pin to edit/move/delete it
* Use Shift-X to toggle the pins on and off

Also adds an entry to the InfoCorner (top left) to display a list of all pins, sortable by type and notes</Description>
    <Authors>William Howard</Authors>
    <SpecialThanks>Translation: German - X-Worf; In-Game testing - bladex; Hot Seat testing - Gedemon</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <Homepage>http://forums.civfanatics.com/showthread.php?t=460944</Homepage>
    <AffectsSavedGames>0</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
