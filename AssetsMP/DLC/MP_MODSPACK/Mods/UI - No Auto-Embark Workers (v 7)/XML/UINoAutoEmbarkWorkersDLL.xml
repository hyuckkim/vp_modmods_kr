<?xml version="1.0" encoding="utf-8"?>
<GameData>
	<!-- MUST be in a file on its own, so it can fail if the DLL is not in use -->
	<CustomModOptions>
		<Update>
			<Where Name="UNITS_LOCAL_WORKERS"/>
			<Set Value="1"/>
		</Update>

		<!-- Limits are distances between the unit and the plot as the crow flies, NOT path lengths -->
		<Update>
			<Where Name="UNITS_LOCAL_WORKERS_LANDLIMIT"/>
			<Set Value="8"/>
		</Update>
		<Update>
			<Where Name="UNITS_LOCAL_WORKERS_WATERLIMIT"/>
			<Set Value="12"/>
		</Update>

		<Update>
			<Where Name="GLOBAL_QUICK_ROUTES"/>
			<Set Value="1"/>
		</Update>
	</CustomModOptions>
</GameData>