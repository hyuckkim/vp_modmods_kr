<?xml version="1.0" encoding="utf-8"?>
<Mod id="299296de-d4ca-4a2a-9021-ce14b68b4227" version="3">
  <Properties>
    <Name>UI - Diplomacy Log</Name>
    <Stability>Beta</Stability>
    <Teaser>UI - Diplomacy Log</Teaser>
    <Description>Adds an entry to the diplo corner menu to review all diplomacy related messages.
	
Modifies the diplomacy screen adding buttons for "Remember this reply for this leader" and "Remember this reply for ALL leaders".  If a reply is remembered it will be used to auto-answer future identical questions from the specified (or all) leader(s).  Auto-answered questions will still appear in the diplomacy log.</Description>
    <Authors>William Howard</Authors>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>0</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>0</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
  <Dependencies>
    <Mod id="d1b6328c-ff44-4b0d-aad7-c657f83610cd" minversion="68" maxversion="999" title="DLL - Various Mod Components" />
  </Dependencies>
