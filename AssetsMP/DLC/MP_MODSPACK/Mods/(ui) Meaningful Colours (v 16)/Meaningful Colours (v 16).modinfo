<?xml version="1.0" encoding="utf-8"?>
<Mod id="7db75fa8-0dd6-424d-8130-b79c37b04398" version="16">
  <Properties>
    <Name>(ui) Meaningful Colours</Name>
	<Teaser>Former "Meaningful City-States Colours" and "Redesigned Colours and Icons" with only first part left. Compatible with UCS</Teaser>
    <Description>New colour schemes for every City-State, for more variety, more historical accuracy, and more enjoyment. Replaces both the icons themselves and the colors of units and cities. All City States get new unique colours, and the colours are grouped by the traits of the city states.</Description>
    <Authors>adan_eslavo, ryanmusante</Authors>
    <SpecialThanks>whoward69, jptrrs, dylansan, Sylvestrina</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <Homepage>https://forums.civfanatics.com/threads/meaningful-colours.636237/</Homepage>
	<AffectsSavedGames>0</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>1</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>1</ReloadStrategicViewSystem>
    <ReloadUnitSystem>1</ReloadUnitSystem>
  </Properties>
