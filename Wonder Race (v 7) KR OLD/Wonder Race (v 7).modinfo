<?xml version="1.0" encoding="utf-8"?>
<Mod id="726cd01f-8ea2-4438-8085-21ee14bd9500" version="7">
  <Properties>
    <Name>Wonder Race</Name>
    <Teaser>[COLOR_GREEN]A notice is sent when you are competing with the AI for a wonder.[ENDCOLOR]</Teaser>
    <Description>A notice is sent when you are competing with the AI for a wonder. The notice will either say you are winning or losing the wonder race, and the tooltip for the notification will tell you which wonder.[NEWLINE][NEWLINE]The notification is sent once everytime the race status changes.</Description>
    <Authors>hambil, Cynther</Authors>
    <SpecialThanks>whoward69</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>0</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
