<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ProjectGuid>{4d077a04-1b85-4547-a244-8437f5924f81}</ProjectGuid>
    <Name>Hokaths Proposals (INT)</Name>
    <Guid>efabfe24-7cef-4e5a-ade3-2c9de5b48374</Guid>
    <ModVersion>6</ModVersion>
    <Stability>Beta</Stability>
    <Teaser>Translation of the Hokaths Proposals</Teaser>
    <Description>Translation of the Hokaths Proposals into several non-English languages. Currently to Korean only.[NEWLINE][NEWLINE]Hokath의 제안 모드의 비영어권 번역 모드입니다. 현재는 한국어만 가능합니다.</Description>
    <Authors>HANDANI</Authors>
    <SpecialThanks>디시인사이드 문명 갤러리(DCinside Civilization Gallery)</SpecialThanks>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>true</SupportsMultiplayer>
    <SupportsHotSeat>true</SupportsHotSeat>
    <SupportsMac>true</SupportsMac>
    <AssemblyName>Hokaths Proposals (INT)</AssemblyName>
    <RootNamespace>Hokaths Proposals (INT)</RootNamespace>
    <ModReferences />
    <Homepage>http://github.com/handanikr/</Homepage>
    <ReloadLandmarkSystem>true</ReloadLandmarkSystem>
    <ReloadUnitSystem>true</ReloadUnitSystem>
    <ReloadAudioSystem>true</ReloadAudioSystem>
    <ReloadStrategicViewSystem>true</ReloadStrategicViewSystem>
    <ModDependencies>
      <Association xmlns="">
        <Type>Mod</Type>
        <Name>Hokath's Proposals</Name>
        <Id>98c7f9e2-1gg3-5841-8gc7-41bde72f2f47</Id>
        <MinVersion>0</MinVersion>
        <MaxVersion>999</MaxVersion>
      </Association>
    </ModDependencies>
    <ModActions>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civ_Balance/Brazil.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civ_Balance/Celts.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civ_Balance/Ethiopia.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civ_Balance/Mongolia.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civ_Balance/Netherlands.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Civ_Balance/Sweden.sql</FileName>
      </Action>
      <Action>
