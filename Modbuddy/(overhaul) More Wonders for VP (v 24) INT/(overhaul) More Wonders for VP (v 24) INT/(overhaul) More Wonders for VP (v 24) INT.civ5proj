<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ProjectGuid>{6cb14e43-af1d-428d-bfdc-761e5b3d478e}</ProjectGuid>
    <Name>(overhaul) More Wonders for VP INT</Name>
    <Guid>43b6b232-5380-40da-8511-d9578cdb9131</Guid>
    <ModVersion>24</ModVersion>
    <Stability>Alpha</Stability>
    <Teaser>Vox Populi를 위한 더 많은 세계 불가사의</Teaser>
    <Description>이 모드는 Vox Populi에 더 많은 세계 불가사의를 추가합니다. 현재 (공식적으로) VP 4.4.X 버전과 호환됩니다.</Description>
    <Authors>HANDANI</Authors>
    <SpecialThanks>디시인사이드 문명 갤러리(DCinside Civilization Gallery)</SpecialThanks>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>true</SupportsMultiplayer>
    <SupportsHotSeat>true</SupportsHotSeat>
    <SupportsMac>true</SupportsMac>
    <AssemblyName>(overhaul) More Wonders for VP (v 24) INT</AssemblyName>
    <RootNamespace>(overhaul) More Wonders for VP (v 24) INT</RootNamespace>
    <ModReferences />
    <ModDependencies>
      <Association xmlns="">
        <Type>Mod</Type>
        <Name>(overhaul) More Wonders for VP</Name>
        <Id>3e151552-1683-4881-b736-8ee89226f599</Id>
        <MinVersion>0</MinVersion>
        <MaxVersion>999</MaxVersion>
      </Association>
    </ModDependencies>
    <ModActions>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>1.WorldWonders/SQL/MainRulesForWorldWonders.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>1.WorldWonders/SQL/WorldWondersDefinitions.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>1.WorldWonders/SQL/WorldWondersTexts.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>2.NaturalWonders/SQL/NaturalWondersCivilopediaTexts.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>2.NaturalWonders/SQL/UniqueNaturalWondersAbilities.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>2.NaturalWonders/XML/NaturalWondersTexts.xml</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Buildings/BuildingsDefinitions.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Resources/ResourcesDefinitions.sql</FileName>
      </Action>
    </ModActions>
    <Homepage>http://github.com/handanikr/vp_modmods_kr</Homepage>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Package Only' ">
    <PackageMod>true</PackageMod>
    <DeployMod>false</DeployMod>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Deploy Only' ">
    <PackageMod>false</PackageMod>
    <DeployMod>true</DeployMod>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="1.WorldWonders\" />
    <Folder Include="1.WorldWonders\SQL\" />
    <Folder Include="2.NaturalWonders\" />
    <Folder Include="2.NaturalWonders\SQL\" />
