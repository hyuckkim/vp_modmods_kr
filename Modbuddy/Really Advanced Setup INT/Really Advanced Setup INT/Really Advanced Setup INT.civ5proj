<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ProjectGuid>{a4585de8-eed7-43aa-ad2d-16895f89adc9}</ProjectGuid>
    <Name>Really Advanced Setup INT</Name>
    <Guid>5d9ccb7a-9c04-499b-afdf-c6b4a3410612</Guid>
    <ModVersion>15</ModVersion>
    <Stability>Beta</Stability>
    <Teaser>Translation of the Really Advanced Setup</Teaser>
    <Description>Translation of the Really Advanced Setup into several non-English languages. Currently to Korean only.[NEWLINE][NEWLINE]진짜 고급 설정 모드의 비영어권 번역 모드입니다. 현재는 한국어만 가능합니다.</Description>
    <Authors>HANDANI</Authors>
    <SpecialThanks>디시인사이드 문명 갤러리(DCinside Civilization Gallery)</SpecialThanks>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>false</SupportsHotSeat>
    <SupportsMac>true</SupportsMac>
    <AssemblyName>Really Advanced Setup INT</AssemblyName>
    <RootNamespace>Really Advanced Setup INT</RootNamespace>
    <ModReferences />
    <Homepage>http://github.com/handanikr/</Homepage>
    <ModActions>
