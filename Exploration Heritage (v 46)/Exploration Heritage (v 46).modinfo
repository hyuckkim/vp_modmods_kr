<Mod id="1d68926a-0cf9-44af-80e9-5bd1208fba7b" version="46">
  <Properties>
    <Name>Exploration Heritage</Name>
    <Stability>Beta</Stability>
    <Teaser>New recon units can reclaim lost exploration XP...[NEWLINE][NEWLINE][COLOR_POSITIVE_TEXT]Compatibility: VP[ENDCOLOR]</Teaser>
    <Description>Recon XP is tracked collectively as a 'pool', and when high level recon is lost, XP pool increases, granting bonus XP per turn to University-promoted, undamaged recon units based on distance from capital</Description>
    <Authors>Tekamthi</Authors>
    <SpecialThanks>vp community</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
