	<EntryPoints>
	    <EntryPoint type="InGameUIAddin" file="DummyPolicies.lua">
	      <Name>CDDummies</Name>
	      <Description>Allocate each civ a dummy to mark their culture</Description>
	    </EntryPoint>
	    <EntryPoint type="InGameUIAddin" file="Map/ResourceSpawner.lua">
	      <Name>ResourceSpawner</Name>
	      <Description>Do the job the ResourcePlotsToPlace is meant to do</Description>
	    </EntryPoint>
	    <EntryPoint type="InGameUIAddin" file="Units/EventTrigger.lua">
	      <Name>UnitEvents</Name>
	      <Description>Activate GP Events on birth</Description>
	    </EntryPoint>
	</EntryPoints>
</Mod>