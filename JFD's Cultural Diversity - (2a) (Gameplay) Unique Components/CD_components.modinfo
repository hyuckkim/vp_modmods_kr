	<Actions>
	<OnModActivated>
		<UpdateDatabase>Art/Promotions/PromoAtlas.xml</UpdateDatabase>
		<UpdateDatabase>Art/Units/FlagAtlas.xml</UpdateDatabase>
		<UpdateDatabase>Art/IconAtlas.xml</UpdateDatabase>

		<UpdateDatabase>Compatibility.sql</UpdateDatabase> 
		<!-- reassignments affects compatibility table -->
		<UpdateDatabase>Reassignments.sql</UpdateDatabase>

		<UpdateDatabase>Map/NewResources.xml</UpdateDatabase>
		<UpdateDatabase>Map/Reindeer.sql</UpdateDatabase>
		<UpdateDatabase>Map/MapText.xml</UpdateDatabase>
