		<UpdateDatabase>Units/UnitSweeps.sql</UpdateDatabase>
		<UpdateDatabase>Units/NewPromotions.xml</UpdateDatabase>
		<UpdateDatabase>Units/DjeliText.xml</UpdateDatabase>

		<!-- this updates icons on already added units and buildings -->
		<!-- it also sets the overrides -->
