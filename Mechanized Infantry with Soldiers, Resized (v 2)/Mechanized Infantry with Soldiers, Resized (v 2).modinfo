<?xml version="1.0" encoding="utf-8"?>
<Mod id="f78d7560-ecf0-4f48-9a5c-f2fb4b6ca22a" version="2">
  <Properties>
    <Name>Mechanized Infantry with Soldiers, Resized</Name>
    <Teaser>Adds soldiers to the Mechanized Infantry unit</Teaser>
    <Description>This mod changes the Mechanized Infantry unit so that its unit art includes four modern soldiers and two vehicles.  The mod is intended to give greater flavor to the latest infantry unit in the game, by having a formation with soldiers on foot in addition to the vehicles.  

This variant of the mod reduces the size of the soldiers for purposes of scale.  The default version contains soldiers that are the same size as Paratroopers.</Description>
    <Authors>Tidal Resonance</Authors>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>0</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>1</ReloadUnitSystem>
  </Properties>
