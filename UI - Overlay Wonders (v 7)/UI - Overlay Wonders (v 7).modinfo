<Mod id="e915c6ee-16bc-44cf-9a2f-15746f414c63" version="7">
  <Properties>
    <Name>UI - Overlay Wonders</Name>
    <Teaser>Adds a Wonders entry in the Overlay menu in strategic view that highlights all Natural Wonders and cities with a World Wonder</Teaser>
    <Description>Adds a Wonders entry in the Overlay menu in strategic view that highlights all Natural Wonders and cities with a World Wonder

Hooks into the MiniMap Panel Overlay drop-down via the "Utils - Modular MiniMap Overlays" mod</Description>
    <Authors>William Howard</Authors>
    <HideSetupGame>0</HideSetupGame>
    <Homepage>http://forums.2kgames.com/showthread.php?119290-MOD-UI-Wonders</Homepage>
